{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "electro-studio",
  "version": "0.1.0",
  "identifier": "com.electro.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @electro/ui dev",
    "beforeBuildCommand": "pnpm --filter @electro/ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../packages/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Electro Studio",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}